# Jeton du bot (Developer Portal > Bot > Token). Jamais commité.
DISCORD_TOKEN=

*** ID du serveur géré (le seul que Edge accepte)
GUILD_ID=1558076024778919946

# Supabase > Project settings > Database > Connection string
# Session pooler  = port 5432 (préférable pour un bot qui tourne en continu)
# Transaction pooler = port 6543 (le bot désactive alors les requêtes préparées, cf. src/db/pg.ts)
DATABASE_URL=

# true = Edge ne se connecte pas à Discord, il simule et rapporte l'état de la structure
EDGE_DRY_RUN=false
# true = Edge requiert l'intent MessageContent (automod/XP). false = ces modules se désactivent proprement
EDGE_REQUIRE_MESSAGE_CONTENT=true
EDGE_LOG_LEVEL=info

# ------------------------------------------------------------------ Déploiement
# Un hébergeur (Northflank, Render, Fly.io, Railway) fournit PORT : Edge y ouvre alors une
# sonde HTTP — /health pour prouver qu'il vit, /ready pour dire qu'il est opérationnel.
# Sans port qui répond, beaucoup de plans gratuits jugent le service cassé et l'endorment.
# En local, laisse PORT vide : aucune sonde, aucun port ouvert.
PORT=
# true = ouvre quand même la sonde sur 8080 (utile pour la tester sans hébergeur)
EDGE_HEALTH=false
# URL que Edge tapera toutes les EDGE_KEEPALIVE_MINUTES minutes (8080/health par defaut :
# sert a signaler ta supervision, ou a garder chaude une route publique). A NE PAS COMPTER
# comme reveil : un service deja endormi par la plateforme a son minuteur gele avec lui —
# sur Render, c'est un sondeur EXTERNE (UptimeRobot) sur /health qu'il te faut.
KEEPALIVE_URL=
EDGE_KEEPALIVE_MINUTES=4
