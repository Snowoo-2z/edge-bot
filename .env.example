# Jeton du bot (Developer Portal > Bot > Reset Token -> Copy ; affiche une seule fois). Jamais commité.
# Regle de saisie (Render, systemd, docker-compose) : NI guillemets, NI espace final, NI prefixe
# «Bearer » — la valeur est utilisee byte pour byte, un JWT suivi d'un espace est refuse.
DISCORD_TOKEN=

# ID du serveur géré (le seul que Edge accepte) — pour la relire : Discord
# Paramètres → Avancé → Mode développeur, puis clic droit sur le serveur → Copier l'identifiant
GUILD_ID=1558076024778919946

# ------------------------------------------------------------------ Base de données (Supabase)
# La voie recommandee : l'API HTTP de Supabase. Deux valeurs, copiees du dashboard, et le tour
# est joue. Pas de mot de passe de base, pas de pooler, pas d'IP a autoriser.
#   1) colle supabase/schema.sql dans Supabase → SQL Editor → Run   (idempotent, ne detruit rien)
#   2) remplis les deux lignes ci-dessous
# La reference du projet est dans l'URL du dashboard : https://ABCDEF.supabase.co → ABCDEF
SUPABASE_URL=
# Project Settings → API → Secret keys → « service_role » (commence par eyJ…). La « anon » ne
# peut pas ecrire : Edge lit le role dans le JWT et te le dit avant de tenter quoi que ce soit.
SUPABASE_SERVICE_ROLE_KEY=
# Seulement si ton PostgREST n'expose pas le schema `public` (projet auto-heberge, multi-tenant).
SUPABASE_SCHEMA=

# Optionnel, a laisser vide dans 99 % des cas : la connexion Postgres directe (pg).
# Ignore des que SUPABASE_URL est rempli. Si tu y tiens (agregations sur mesure, npm run db:migrate) :
#   directe (sans pooler) : postgres://postgres:[MOT_DE_PASSE]@db.[REF].supabase.co:5432/postgres
#   transaction pooler    : postgres://postgres.[REF]:[MOT_DE_PASSE]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Le mot de passe est celui de la BASE (Project Settings → Database → Reset database password).
DATABASE_URL=

# true = Edge ne se connecte pas à Discord, il simule et rapporte l'état de la structure
EDGE_DRY_RUN=false
# true = Edge requiert l'intent MessageContent (automod/XP). false = ces modules se désactivent proprement
EDGE_REQUIRE_MESSAGE_CONTENT=true
EDGE_LOG_LEVEL=info

# ------------------------------------------------------------------ Déploiement
# Un hébergeur (Northflank, Render, Fly.io, Railway) fournit PORT : Edge y ouvre alors une
# sonde HTTP — /health pour prouver qu'il vit, /ready pour dire qu'il est opérationnel.
# Sans port qui répond, beaucoup de plans gratuits jugent le service cassé et l'endorment.
# En local, laisse PORT vide : aucune sonde, aucun port ouvert.
PORT=
# true = ouvre quand même la sonde sur 8080 (utile pour la tester sans hébergeur)
EDGE_HEALTH=false
# Autoping : sur Render, RIEN à régler — Edge détecte RENDER_EXTERNAL_URL et se tape son
# propre /health toutes les 4 min, ce qui empêche la plateforme de l'endormir.
# KEEPALIVE_URL sert ailleurs : surveiller une URL qui n'est pas /health, une supervision,
# ou un autre hébergeur qui dort. Un service DÉJÀ endormi ne peut pas se réveiller tout seul
# (son minuteur est gelé avec lui) : pour ça, le workflow deploy/autoping-github.yml → .github/workflows/edge-autoping.yml.
KEEPALIVE_URL=
# (Render : 4 min par défaut, réglable en minutes — ne descends pas sous 1 min)
EDGE_KEEPALIVE_MINUTES=4
